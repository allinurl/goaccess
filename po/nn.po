#: src/labels.h:487
msgid "401 - Unauthorized: Request needs user authentication"
msgstr "401 - Ikkje autorisert: Førespurnaden krev brukarautentisering"

#: src/labels.h:489
msgid "402 - Payment Required"
msgstr "402 - Betaling krevst"

#: src/labels.h:491
msgid "403 - Forbidden: Server is refusing to respond to it"
msgstr "403 - Forbode: Tenaren nektar å svare på det"

#: src/labels.h:493
msgid "404 - Not Found: Requested resource could not be found"
