#: src/labels.h:445
msgid "100 - Continue: Server received the initial part of the request"
msgstr "100 - Fortset: Tenaren har motteke den første delen av førespurnaden"

#: src/labels.h:447
msgid "101 - Switching Protocols: Client asked to switch protocols"
msgstr "101 - Protokollskifte: Klienten bad om å skifte protokoll"

#: src/labels.h:449
msgid "200 - OK: The request sent by the client was successful"
msgstr "200 - OK: Førespurnaden frå klienten gjekk bra"

#: src/labels.h:451
msgid "201 - Created: The request has been fulfilled and created"
msgstr "201 - Oppretta: Førespurnaden er utført, og ressursen er oppretta"

#: src/labels.h:453
msgid "202 - Accepted: The request has been accepted for processing"
msgstr "202 - Godteken: Førespurnaden er godteken for handsaming"

#: src/labels.h:455
msgid "203 - Non-authoritative Information: Response from a third party"
msgstr "203 - Ikkje-autoritativ informasjon: Svar frå ein tredjepart"

#: src/labels.h:457
msgid "204 - No Content: Request did not return any content"
msgstr "204 - Ikkje noko innhald: Førespurnaden returnerte ikkje noko innhald"

#: src/labels.h:459
msgid "205 - Reset Content: Server asked the client to reset the document"
msgstr ""
"205 - Tilbakestill innhald: Tenaren bad klienten om å tilbakestille "
"dokumentet"

#: src/labels.h:461
msgid "206 - Partial Content: The partial GET has been successful"
msgstr "206 - Delvis innhald: Den delvise GET-førespurnaden gjekk bra"

#: src/labels.h:463
msgid "207 - Multi-Status: WebDAV; RFC 4918"
msgstr "207 - Fleirstatus: WebDAV; RFC 4918"

#: src/labels.h:465
msgid "208 - Already Reported: WebDAV; RFC 5842"
msgstr "208 - Allereie rapportert: WebDAV; RFC 5842"

#: src/labels.h:467
msgid "218 - This is fine: Apache servers. A catch-all error condition"
msgstr "218 - Dette er greitt: Apache-tenarar. Ein felles feiltilstand"

#: src/labels.h:469
msgid "300 - Multiple Choices: Multiple options for the resource"
msgstr "300 - Fleire val: Ressursen har fleire alternativ"

#: src/labels.h:471
msgid "301 - Moved Permanently: Resource has permanently moved"
msgstr "301 - Flytta permanent: Ressursen er flytta permanent"

#: src/labels.h:473
msgid "302 - Moved Temporarily (redirect)"
msgstr "302 - Flytta mellombels (omdirigering)"

#: src/labels.h:475
msgid "303 - See Other Document: The response is at a different URI"
msgstr "303 - Sjå anna dokument: Svaret er på ein annan URI"

#: src/labels.h:477
msgid "304 - Not Modified: Resource has not been modified"
msgstr "304 - Ikkje endra: Ressursen er ikkje endra"

#: src/labels.h:479
msgid "305 - Use Proxy: Can only be accessed through the proxy"
msgstr "305 - Bruk mellomtenar: Er berre tilgjengeleg via mellomtenaren"

#: src/labels.h:481
msgid "307 - Temporary Redirect: Resource temporarily moved"
msgstr "307 - Mellombels omdirigering: Ressursen er mellombels flytta"

#: src/labels.h:483
msgid "308 - Permanent Redirect"
msgstr "308 - Permanent omdirigering"

#: src/labels.h:485
msgid "400 - Bad Request: The syntax of the request is invalid"
