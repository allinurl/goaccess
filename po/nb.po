msgid "401 - Unauthorized: Request needs user authentication"
msgstr "401 - Ikke autorisert: Forespørselen krever brukerautentisering"

#: src/labels.h:489
msgid "402 - Payment Required"
msgstr "402 - Betaling kreves"

#: src/labels.h:491
msgid "403 - Forbidden: Server is refusing to respond to it"
msgstr "403 - Forbudt: Tjeneren nekter å svare på det"

#: src/labels.h:493
msgid "404 - Not Found: Requested resource could not be found"
msgstr "404 - Ikke funnet: Fant ikke den forespurte ressursen"

#: src/labels.h:495
msgid "405 - Method Not Allowed: Request method not supported"
