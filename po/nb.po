#: src/labels.h:445
msgid "100 - Continue: Server received the initial part of the request"
msgstr ""
"100 - Fortsett: Tjeneren har mottatt den første delen av forespørselen"

#: src/labels.h:447
msgid "101 - Switching Protocols: Client asked to switch protocols"
msgstr "101 - Protokollskifte: Klienten ba om å skifte protokoller"

#: src/labels.h:449
msgid "200 - OK: The request sent by the client was successful"
msgstr "200 - OK: Forespørselen fra klienten gikk bra"

#: src/labels.h:451
msgid "201 - Created: The request has been fulfilled and created"
msgstr "201 - Opprettet: Forespørselen er utført, og ressursen er opprettet"

#: src/labels.h:453
msgid "202 - Accepted: The request has been accepted for processing"
msgstr "202 - Godtatt: Forespørselen er godtatt for behandling"

#: src/labels.h:455
msgid "203 - Non-authoritative Information: Response from a third party"
msgstr "203 - Ikke-autoritativ informasjon: Svar fra en tredjepart"

#: src/labels.h:457
msgid "204 - No Content: Request did not return any content"
msgstr "204 - Ikke noe innhold: Forespørselen returnerte ikke noe innhold"

#: src/labels.h:459
msgid "205 - Reset Content: Server asked the client to reset the document"
msgstr ""
"205 - Tilbakestill innhold: Tjeneren ba klienten om å tilbakestille "
"dokumentet"

#: src/labels.h:461
msgid "206 - Partial Content: The partial GET has been successful"
msgstr "206 - Delvis innhold: Den delvise GET-forespørselen gikk bra"

#: src/labels.h:463
msgid "207 - Multi-Status: WebDAV; RFC 4918"
msgstr "207 - Flerstatus: WebDAV; RFC 4918"

#: src/labels.h:465
msgid "208 - Already Reported: WebDAV; RFC 5842"
msgstr "208 - Allerede rapportert: WebDAV; RFC 5842"

#: src/labels.h:467
msgid "218 - This is fine: Apache servers. A catch-all error condition"
msgstr ""
"218 - Dette er greit: Apache-tjenere. En samlefeil for alle feiltilstander"

#: src/labels.h:469
msgid "300 - Multiple Choices: Multiple options for the resource"
msgstr "300 - Flere valg: Ressursen har flere alternativer"

#: src/labels.h:471
msgid "301 - Moved Permanently: Resource has permanently moved"
msgstr "301 - Flyttet permanent: Ressursen er flyttet permanent"

#: src/labels.h:473
msgid "302 - Moved Temporarily (redirect)"
msgstr "302 - Flyttet midlertidig (omdirigering)"

#: src/labels.h:475
msgid "303 - See Other Document: The response is at a different URI"
msgstr "303 - Se annet dokument: Svaret er på en annen URI"

#: src/labels.h:477
msgid "304 - Not Modified: Resource has not been modified"
msgstr "304 - Ikke endret: Ressursen er ikke endret"

#: src/labels.h:479
msgid "305 - Use Proxy: Can only be accessed through the proxy"
msgstr "305 - Bruk mellomtjener: Er bare tilgjengelig via mellomtjeneren"

#: src/labels.h:481
msgid "307 - Temporary Redirect: Resource temporarily moved"
msgstr "307 - Midlertidig omdirigering: Ressursen er midlertidig flyttet"

#: src/labels.h:483
msgid "308 - Permanent Redirect"
msgstr "308 - Permanent omdirigering"

#: src/labels.h:485
